# ── LLM Providers ──────────────────────────────────────────────────────────────
# Primary: Google Gemini via AI Studio (free tier)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Fallback: Anthropic Claude (optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Local fallback: Ollama (runs locally, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Controls which provider the agents use: "gemini" | "ollama" | "anthropic"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash          # or gemini-1.5-pro / mistral (ollama)

# ── Database (Supabase) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # needed for server-side writes

# ── GitHub (for PR ingestion) ──────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repo-name         # e.g. "torvalds/linux"

# ── App Config ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development             # development | production
LOG_LEVEL=INFO
